{
  "name": "agrivision-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Animated explainer for AgriVision: NDVI zoning + drone computer vision for targeted (not blanket) crop treatment",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AgriVisionExplainer out/agrivision-explainer.mp4 --codec h264 --crf 16 --overwrite",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/stills.mjs",
    "build:ui": "npm --prefix ui run build"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.539",
    "@remotion/google-fonts": "^4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.539"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
